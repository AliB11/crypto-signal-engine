# ──────────────────────────────────────────────
# Crypto Advanced Signal Scanner – Environment
# ──────────────────────────────────────────────
# این فایل را به `.env` کپی کنید. برنامه *هیچ* متغیر اجباری‌ای ندارد و بدون
# هیچ رمزی کار می‌کند.
#
# نکته: این فایل عمداً فقط متغیرهایی را فهرست می‌کند که کد واقعاً می‌خواند.
# پیش‌تر `DATABASE_URL` و `NODE_ENV` اینجا مستند شده بودند در حالی که هیچ‌جا
# استفاده نمی‌شدند (و `DATABASE_URL` صریحاً «برای قالب قدیمی، استفاده نمی‌شود»
# نوشته شده بود)؛ مستندسازیِ کلیدی که وجود ندارد خودش یک دادهٔ جعلی است.
# برای افزودن متغیر جدید، نخست آن را در کد بخوانید و بعد اینجا مستند کنید.

# ── افت به دادهٔ شبیه‌سازی‌شده ────────────────
# منبع اصلی داده، API عمومی بایننس است (بدون نیاز به کلید). اگر پاسخی نگیرد،
# موتور به یک شبیه‌ساز *قطعی* پناه می‌برد و خروجی را با `dataSource: 'simulated'`
# علامت‌گذاری می‌کند تا هیچ عدد ساختگی‌ای بی‌برچسب وارد تحلیل نشود.
#
#   (پیش‌فرض)  → شبیه‌سازی به‌عنوان آخرین راه حل فعال است، با برچسب صریح
#   off       → شبیه‌سازی کاملاً خاموش؛ در نبود دادهٔ واقعی، درخواست با خطا
#               شکست می‌خورد. برای محیط‌هایی که «یا دادهٔ واقعی یا هیچ» می‌خواهند.
# DATA_SIMULATION_FALLBACK=off

# ── کوین‌گکو (فرادادهٔ بازار) ────────────────
# نام، رتبهٔ بازار، ارزش بازار و حجم ۲۴ساعته از `/api/v3/coins/markets`
# کوین‌گکو خوانده می‌شود. لایهٔ رایگان بدون کلید هم کار می‌کند، اما محدودیت
# نرخ سخت‌گیرانه‌ای دارد؛ اگر کلید رایگان (Demo) دارید آن را اینجا بگذارید تا
# در سرآیند `x-cg-demo-api-key` ارسال شود. در صورت عدم دسترسی، این فیلدها
# `null` گزارش می‌شوند — نه یک رتبهٔ حدسی.
# COINGECKO_API_KEY=

# ── بایننس (API عمومی – بدون کلید) ───────────
# اسپات:   https://data-api.binance.vision  و  https://api.binance.com
# فیوچرز: https://fapi.binance.com
# این‌ها اندپوینت‌های عمومی‌اند و به هیچ کلیدی نیاز ندارند؛ میزبان‌ها به‌صورت
# خودکار چرخش می‌شوند و فیوز مدار در صورت شکست پیاپی باز می‌شود.
